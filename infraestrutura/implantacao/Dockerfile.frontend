FROM node:22-alpine AS construcao

WORKDIR /codigo/aplicativos/frontend

COPY aplicativos/frontend/package.json aplicativos/frontend/package-lock.json ./
RUN npm ci

COPY aplicativos/frontend/index.html \
    aplicativos/frontend/tsconfig.json \
    aplicativos/frontend/tsconfig.app.json \
    aplicativos/frontend/tsconfig.node.json \
    aplicativos/frontend/vite.config.ts \
    ./
COPY aplicativos/frontend/src ./src

ARG VITE_ASSISTENTE_TELEGRAM_HABILITADO=true
ENV VITE_ASSISTENTE_TELEGRAM_HABILITADO=${VITE_ASSISTENTE_TELEGRAM_HABILITADO}

RUN npm run build

FROM nginx:alpine

COPY infraestrutura/implantacao/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=construcao /codigo/aplicativos/frontend/dist /usr/share/nginx/html

EXPOSE 80
