FROM maven:3.9.11-eclipse-temurin-21-alpine AS construcao

WORKDIR /codigo

COPY aplicativos/backend/pom.xml ./pom.xml
RUN mvn --batch-mode --no-transfer-progress dependency:go-offline

COPY aplicativos/backend/src ./src
RUN mvn --batch-mode --no-transfer-progress -DskipTests package \
    && find target -maxdepth 1 -type f -name '*.jar' ! -name '*.original' \
        -exec cp '{}' /aplicacao.jar \; \
    && test -s /aplicacao.jar

FROM node:22-alpine AS codex-cli

RUN npm install --global --prefix /opt/codex-cli \
        @openai/codex@0.145.0 \
    && /opt/codex-cli/bin/codex --version \
    && npm cache clean --force

FROM eclipse-temurin:21-jre-alpine

RUN apk add --no-cache libstdc++ \
    && addgroup -S -g 1000 aplicacao \
    && adduser -S -D -h /home/aplicacao -u 1000 -G aplicacao aplicacao \
    && install -d -o aplicacao -g aplicacao \
        /aplicacao /home/aplicacao /home/aplicacao/.codex

ENV HOME=/home/aplicacao \
    CODEX_HOME=/home/aplicacao/.codex \
    PATH="/opt/codex-cli/bin:${PATH}"

WORKDIR /aplicacao

COPY --from=codex-cli /usr/local/bin/node /usr/local/bin/node
COPY --from=codex-cli /opt/codex-cli /opt/codex-cli
COPY --from=construcao --chown=1000:1000 /aplicacao.jar ./aplicacao.jar

RUN codex --version

USER aplicacao
EXPOSE 8080

ENTRYPOINT ["java", "-jar", "/aplicacao/aplicacao.jar"]
